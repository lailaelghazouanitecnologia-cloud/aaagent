# HCLM-D — z86 Environment Variables
# Copy to .env and fill in values. Then: export $(cat .env | xargs)

# ── Groq (LLM judge for eval pipeline) ──
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=moonshotai/kimi-k2-instruct-0905

# ── Cloudflare (DNS management for z86.dev) ──
# Create token at: https://dash.cloudflare.com/profile/api-tokens
# Permissions needed: Zone → DNS → Edit
CF_API_TOKEN=
CF_ZONE_ID=                # Found in Cloudflare dashboard → domain → Overview (right sidebar)

# ── RunPod (cloud GPU for training + inference) ──
# Get key at: https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=

# ── Optional ──
DASHBOARD_URL=http://localhost:3000
WANDB_PROJECT=hclm-d
