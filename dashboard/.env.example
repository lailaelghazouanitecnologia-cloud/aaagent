# HCLM-D Dashboard — z86.dev
# Copy to .env and fill in values

# Server
DASHBOARD_PORT=3000
DASHBOARD_DB=./metrics.db

# ── Cloudflare (DNS + SSL for z86.dev) ──
CF_API_TOKEN=              # API token with DNS:Edit permissions
CF_ZONE_ID=                # Zone ID from Cloudflare dashboard → Overview

# ── CORS ──
CORS_ORIGINS=https://z86.dev,http://localhost:5173
